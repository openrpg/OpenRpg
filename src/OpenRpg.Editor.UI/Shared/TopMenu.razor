@using System.Reactive.Disposables
@using System.Linq
@using OpenRpg.Editor.Core.Extensions
@using OpenRpg.Editor.Core.Models
@using OpenRpg.Editor.Core.Plugins
@using OpenRpg.Editor.Core.Services.Events.Bus
@using OpenRpg.Editor.Core.Services.Notifications
@using OpenRpg.Editor.Infrastructure.Events
@using OpenRpg.Editor.Infrastructure.Persistence
@using OpenRpg.Editor.Infrastructure.Plugins

@implements IDisposable

@inject EditorState EditorState;
@inject IEventBus EventBus;
@inject SaveProjectExecutor SaveProjectExecutor;
@inject INotifier Notifier;
@inject GenreService GenreService;

<nav class="navbar is-dark" role="navigation" aria-label="main navigation">
    <div class="navbar-menu">
        <div class="navbar-start">
            <span class="tag is-dark app-logo">OpenRpg Editor - v@(GetType().Assembly.GetName().Version) (Alpha)</span>
        </div>
        @if (EditorState.CurrentProject != null)
        {
            <div class="navbar ml-0">
                <div class="navbar-item has-dropdown is-hoverable">
                    <NavLink ActiveClass="is-active" class="navbar-link" Match="NavLinkMatch.All">
                        <span class="icon mr-1"><i class="fas fa-file-lines" aria-hidden="true"></i></span>
                        <span>Templates</span>
                    </NavLink>

                    <div class="navbar-dropdown has-background-grey-dark">
                        @foreach (var templateType in GetTemplateTypes())
                        {
                            <NavLink href="@($"/templates/{templateType.Key}")" ActiveClass="is-active" class="navbar-item" Match="NavLinkMatch.All">
                                <span class="icon mr-1"><i class="fas fa-file-alt" aria-hidden="true"></i></span>
                                <span>@templateType.Name</span>
                            </NavLink>
                        }
                    </div>
                </div>

                <div class="navbar-item has-dropdown is-hoverable">
                    <NavLink ActiveClass="is-active" class="navbar-link" Match="NavLinkMatch.All">
                        <span class="icon mr-1"><i class="fas fa-flag" aria-hidden="true"></i></span>
                        <span>Locales</span>
                    </NavLink>

                    <div class="navbar-dropdown has-background-grey-dark">
                        <NavLink href="locales" ActiveClass="is-active" class="navbar-item" Match="NavLinkMatch.All">
                            <span class="icon mr-1"><i class="fas fa-language" aria-hidden="true"></i></span>
                            <span>Locale Editor</span>
                        </NavLink>
                    </div>
                </div>
            </div>
            <div class="navbar-end">
                <div class="navbar-item has-dropdown is-hoverable">
                    <span class="navbar-link">
                        <span class="icon mr-1"><i class="fas fa-gear" aria-hidden="true"></i></span>
                        <span>Settings</span>
                    </span>
                    <div class="navbar-dropdown has-background-grey-dark">
                        <NavLink href="genres" ActiveClass="is-active" class="navbar-item" Match="NavLinkMatch.All">
                            <span class="icon mr-1"><i class="fas fa-plug" aria-hidden="true"></i></span>
                            <span>Genre Plugins</span>
                        </NavLink>
                    </div>
                </div>
                <button class="button is-primary is-small" @onclick="SaveProject">
                    <span class="icon mr-1"><i class="fas fa-save" aria-hidden="true"></i></span>
                    <span>Save Project</span>
                </button>
            </div>
        }
    </div>
</nav>

@code {

    public CompositeDisposable Subs = new CompositeDisposable();
    
    protected override void OnInitialized()
    {
        EventBus
            .Receive<ProjectChangedEvent>()
            .Subscribe(_ => InvokeAsync(StateHasChanged))
            .AddTo(Subs);
        base.OnInitialized();
    }

    private IEnumerable<ITemplateTypeDescriptor> GetTemplateTypes()
    {
        if (EditorState.CurrentProject == null) return Enumerable.Empty<ITemplateTypeDescriptor>();
        var registry = GenreService.GetTemplateTypeRegistry();
        return registry.GetTemplateTypes();
    }

    public async void SaveProject()
    {
        await SaveProjectExecutor.Execute();
        await Notifier.ShowNotification("Project Saved");
    }

    public void Dispose() => Subs?.Dispose();

}