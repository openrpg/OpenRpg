@page "/templates/{TemplateType}"

@using System.Reflection
@using System.Collections
@using System.Linq
@using OpenRpg.Core.Templates
@using OpenRpg.Data
@using OpenRpg.Data.Conventions.Extensions
@using OpenRpg.Editor.Core.Plugins
@using OpenRpg.Editor.Core.Services.Notifications
@using OpenRpg.Editor.Infrastructure.Plugins
@using OpenRpg.Editor.Infrastructure.Services
@using OpenRpg.Entities.Extensions
@using OpenRpg.Localization.Data.Repositories
@using OpenRpg.Core.Variables

@inject INotifier Notifier
@inject IRepository Repository
@inject ILocaleRepository LocaleRepository
@inject ICloner Cloner
@inject NavigationManager NavigationManager
@inject GenreService GenreService

<style>
    .template-link {
        color: #363636 !important;
        font-weight: 500;
    }
    .template-link:hover {
        background-color: #f5f5f5;
        color: #363636 !important;
    }
    .template-link.is-active {
        background-color: #3273dc !important;
        color: white !important;
    }
</style>

<div class="columns">
    <div class="column is-one-fifth">
        @if (Descriptor != null)
        {
            <div class="box">
                <div class="content">
                    <h4 class="title is-5">@Descriptor.Name</h4>
                    <p class="mb-2">
                        <span class="tag is-info">@TemplateType</span>
                    </p>
                    <button class="button is-primary is-fullwidth" @onclick="AddTemplate">
                        <span class="icon"><i class="fas fa-plus"></i></span>
                        <span>Add New</span>
                    </button>
                </div>
            </div>
            <div class="box">
                <p class="menu-label">@Descriptor.Name</p>
                <ul class="menu-list">
                    @foreach (var template in GetTemplateList())
                    {
                        var id = template.GetType().GetProperty("Id")?.GetValue(template) as int? ?? 0;
                        var variables = template.GetType().GetProperty("Variables")?.GetValue(template) as IVariables<object>;
                        var assetCode = variables?.HasAssetCode() == true 
                            ? variables.AssetCode : $"{Descriptor.AssetCodePrefix}-{id}";
                        <li>
                            <a class="template-link @(CurrentTemplate == template ? "is-active" : "")" @onclick="() => SelectTemplate(template)">
                                <span>@assetCode</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="box">
                <p class="content">Select a template type to edit:</p>
                @foreach (var type in GetTemplateTypes())
                {
                    <button class="button is-fullwidth mb-2 is-align-items-center" @onclick="() => NavigateToType(type.Key)">
                        <span class="icon mr-2">
                            <i class="fas fa-file-alt"></i>
                        </span>
                        <span>@type.Name</span>
                    </button>
                }
            </div>
        }
    </div>
    <div class="column">
        @if (CurrentTemplate != null && Descriptor != null && _dynamicEditor != null)
        {
            <DynamicComponent Type="@_dynamicEditor" Parameters="@_editorParams" />
        }
        else if (Descriptor != null)
        {
            <div class="notification is-info">
                No @Descriptor.Name selected. Click "Add New" above to create one.
            </div>
        }
        else
        {
            <div class="notification is-warning">
                Please select a template type from the left panel.
            </div>
        }
    </div>
</div>

@if (CurrentTemplate != null)
{
    <div class="container m-4">
        <div class="field is-grouped has-text-centered">
            <p class="control">
                <a class="button is-info" @onclick="CloneTemplate">
                    Clone @(FriendlyName) Template
                </a>
            </p>
            <p class="control">
                <a class="button is-danger" @onclick="DeleteTemplate">
                    Delete @(FriendlyName) Template
                </a>
            </p>
        </div>
    </div>
}

@code {
    [Parameter]
    public string TemplateType { get; set; }

    private ITemplateTypeDescriptor Descriptor;
    private ITemplate CurrentTemplate;
    private Type _templateType;
    private string FriendlyName = "";
    private MethodInfo _getAllMethod;
    private MethodInfo _createMethod;
    private MethodInfo _deleteMethod;

    private Type _dynamicEditor;
    private Dictionary<string, object> _editorParams = new();

    private static readonly Dictionary<Type, Type> _templateToEditorType = new();

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(TemplateType))
        {
            LoadTemplateType();
        }
        BuildEditorMapping();
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(TemplateType))
        {
            LoadTemplateType();
        }
        else
        {
            Descriptor = null;
            CurrentTemplate = null;
            _dynamicEditor = null;
            _editorParams.Clear();
        }
        base.OnParametersSet();
    }

    private void BuildEditorMapping()
    {
        if (_templateToEditorType.Count == 0)
        {
            _templateToEditorType[typeof(OpenRpg.Items.Templates.ItemTemplate)] = typeof(DynamicTemplateEditor<OpenRpg.Items.Templates.ItemTemplate>);
            _templateToEditorType[typeof(OpenRpg.Quests.Quest)] = typeof(DynamicTemplateEditor<OpenRpg.Quests.Quest>);
            _templateToEditorType[typeof(OpenRpg.Entities.Classes.Templates.ClassTemplate)] = typeof(DynamicTemplateEditor<OpenRpg.Entities.Classes.Templates.ClassTemplate>);
            _templateToEditorType[typeof(OpenRpg.Entities.Races.Templates.RaceTemplate)] = typeof(DynamicTemplateEditor<OpenRpg.Entities.Races.Templates.RaceTemplate>);
            _templateToEditorType[typeof(OpenRpg.Items.TradeSkills.Templates.ItemCraftingTemplate)] = typeof(DynamicTemplateEditor<OpenRpg.Items.TradeSkills.Templates.ItemCraftingTemplate>);
            _templateToEditorType[typeof(OpenRpg.Items.TradeSkills.Templates.ItemGatheringTemplate)] = typeof(DynamicTemplateEditor<OpenRpg.Items.TradeSkills.Templates.ItemGatheringTemplate>);
            _templateToEditorType[typeof(OpenRpg.Genres.Scifi.Ships.ShipTemplate)] = typeof(DynamicTemplateEditor<OpenRpg.Genres.Scifi.Ships.ShipTemplate>);
        }
    }

    private void LoadTemplateType()
    {
        var registry = GenreService.GetTemplateTypeRegistry();
        Descriptor = registry.GetTemplateType(TemplateType);

        if (Descriptor == null)
        {
            return;
        }

        _templateType = Type.GetType(Descriptor.TemplateTypeName);
        if (_templateType == null)
        {
            return;
        }

        if (_templateToEditorType.TryGetValue(_templateType, out var editorType))
        {
            _dynamicEditor = editorType;
        }
        else
        {
            var genericEditorType = typeof(DynamicTemplateEditor<>).MakeGenericType(_templateType);
            _dynamicEditor = genericEditorType;
        }

        FriendlyName = Descriptor.Name;
        _getAllMethod = typeof(RepositoryExtensions).GetMethod("GetAll")?.MakeGenericMethod(_templateType);
        _createMethod = typeof(RepositoryExtensions).GetMethod("Create")?.MakeGenericMethod(_templateType);
        _deleteMethod = typeof(RepositoryExtensions).GetMethod("Delete")?.MakeGenericMethod(_templateType);

        UpdateEditorParams();

        var templates = _getAllMethod?.Invoke(null, [Repository]) as IEnumerable;
        CurrentTemplate = templates?.Cast<ITemplate>().FirstOrDefault();

        if (CurrentTemplate != null)
        {
            var listifyMethod = CurrentTemplate.GetType().GetMethod("ListifyProperties");
            listifyMethod?.Invoke(CurrentTemplate, null);
        }

        if (CurrentTemplate == null)
        {
            AddTemplate();
        }
    }

    private void UpdateEditorParams()
    {
        _editorParams = new Dictionary<string, object>
        {
            { "Template", CurrentTemplate },
            { "AssetCodePrefix", Descriptor.AssetCodePrefix },
            { "ExternalGroups", GetEditorGroups() }
        };
    }

    private IEnumerable<ITemplateTypeDescriptor> GetTemplateTypes()
    {
        var registry = GenreService.GetTemplateTypeRegistry();
        return registry.GetTemplateTypes();
    }

    private List<TemplateEditorGroup> GetEditorGroups()
    {
        if (Descriptor?.Groups != null)
        {
            return Descriptor.Groups.Select(g => new TemplateEditorGroup
            {
                Title = g.Title,
                EditorComponent = g.EditorComponent,
                Options = g.Options ?? new Dictionary<string, string>(),
                Fields = g.Fields?.Select(f => new TemplateEditorField
                {
                    Property = f.Property,
                    Name = f.Name,
                    EditorType = f.EditorType,
                    EditorComponent = f.EditorComponent,
                    Options = f.Options ?? new Dictionary<string, string>()
                }).ToList() ?? new List<TemplateEditorField>()
            }).ToList();
        }
        return new List<TemplateEditorGroup>();
    }

    private List<ITemplate> GetTemplateList()
    {
        if (_getAllMethod == null) return new List<ITemplate>();
        var templates = _getAllMethod.Invoke(null, [Repository]) as IEnumerable;
        return templates?.Cast<ITemplate>().ToList() ?? new List<ITemplate>();
    }

    private void NavigateToType(string type)
    {
        NavigationManager.NavigateTo($"/templates/{type}");
    }

    private void AddTemplate()
    {
        var newId = GetNewId();
        var newTemplate = Activator.CreateInstance(_templateType) as ITemplate;
        if (newTemplate == null) return;

        var setIdMethod = newTemplate.GetType().GetMethod("SetId");
        setIdMethod?.Invoke(newTemplate, [newId]);

        var listifyMethod = newTemplate.GetType().GetMethod("ListifyProperties");
        listifyMethod?.Invoke(newTemplate, null);

        var variablesProperty = newTemplate.GetType().GetProperty("Variables");
        var variables = variablesProperty?.GetValue(newTemplate) as IVariables<object>;
        var assetCode = $"{Descriptor.AssetCodePrefix}-{newId}";
        if (variables != null) { variables.AssetCode = assetCode; }

        var generateLocaleMethod = newTemplate.GetType().GetMethod("GenerateLocaleCodes");
        generateLocaleMethod?.Invoke(newTemplate, [assetCode]);

        _createMethod?.Invoke(null, [Repository, newTemplate, newId]);

        CurrentTemplate = newTemplate;
        UpdateEditorParams();
        StateHasChanged();
    }

    private void SelectTemplate(ITemplate template)
    {
        var listifyMethod = template.GetType().GetMethod("ListifyProperties");
        listifyMethod?.Invoke(template, null);
        CurrentTemplate = template;
        UpdateEditorParams();
        StateHasChanged();
    }

    private int GetNewId()
    {
        var templates = _getAllMethod?.Invoke(null, [Repository]) as IEnumerable;
        var existingIds = templates?.Cast<object>()
            .Select(t => t.GetType().GetProperty("Id")?.GetValue(t) as int? ?? 0)
            .Where(id => id > 0)
            .ToHashSet() ?? new HashSet<int>();

        var newId = 1;
        while (existingIds.Contains(newId))
        {
            newId++;
        }
        return newId;
    }

    private async Task DeleteTemplate()
    {
        if (CurrentTemplate == null) return;

        var idProperty = CurrentTemplate.GetType().GetProperty("Id");
        var id = idProperty?.GetValue(CurrentTemplate) as int? ?? 0;

        _deleteMethod?.Invoke(null, [Repository, id]);

        await Notifier.ShowNotification($"Deleted {FriendlyName} Template");

        var templates = _getAllMethod?.Invoke(null, [Repository]) as IEnumerable;
        CurrentTemplate = templates?.Cast<ITemplate>().FirstOrDefault();

        if (CurrentTemplate == null)
        {
            AddTemplate();
        }
        else
        {
            UpdateEditorParams();
        }

        StateHasChanged();
    }

    private async Task CloneTemplate()
    {
        if (CurrentTemplate == null) return;

        var clone = Cloner.Clone<object>(CurrentTemplate);
        var newId = GetNewId();

        var setIdMethod = clone.GetType().GetMethod("SetId");
        setIdMethod?.Invoke(clone, [newId]);

        var listifyMethod = clone.GetType().GetMethod("ListifyProperties");
        listifyMethod?.Invoke(clone, null);

        var variablesProperty = clone.GetType().GetProperty("Variables");
        var assetCodeProperty = variablesProperty?.PropertyType.GetProperty("AssetCode");
        var currentAssetCode = assetCodeProperty?.GetValue(variablesProperty?.GetValue(clone))?.ToString() ?? "";
        assetCodeProperty?.SetValue(variablesProperty?.GetValue(clone), $"{currentAssetCode}-clone");

        var generateLocaleMethod = clone.GetType().GetMethod("GenerateLocaleCodes");
        generateLocaleMethod?.Invoke(clone, [$"{currentAssetCode}-clone"]);

        _createMethod?.Invoke(null, [Repository, clone, newId]);

        await Notifier.ShowNotification($"Cloned {FriendlyName} Template");

        CurrentTemplate = (ITemplate)clone;
        UpdateEditorParams();
        StateHasChanged();
    }
}