@page "/"

@using OpenRpg.Editor.Core.Components.Modal
@using OpenRpg.Editor.Core.Models
@using OpenRpg.Editor.Core.Plugins
@using OpenRpg.Editor.Core.Services.Events.Bus
@using OpenRpg.Editor.Core.Services.FileSystem
@using OpenRpg.Editor.Core.Services.Modal
@using OpenRpg.Editor.Infrastructure.Events
@using OpenRpg.Editor.Infrastructure.Persistence
@using OpenRpg.Editor.Infrastructure.Plugins
@using OpenRpg.Editor.UI.Components.Modals
@using OpenRpg.Editor.UI.Models

@inject IFileBrowser FileBrowser
@inject EditorState EditorState
@inject ProjectCreator ProjectCreator
@inject EditorDataLoader EditorDataLoader
@inject IEventBus EventBus
@inject GenreService GenreService

<h1 class="title is-1">OpenRpg Data Editor</h1>

<div class="box">
    @if (EditorState.ProjectContext == null)
    {
        <p class="content">Please create or load an existing project.</p>
        <div class="field">
            <div class="control">
                <a class="button is-primary" @onclick="CreateProject">Create New Project</a>
            </div>
        </div>
        <div class="field">
            <label class="label is-4">Or</label>
        </div>
        <div class="field">
            <div class="control">
                <a class="button is-primary" @onclick="OpenProject">Open Existing Project</a>
            </div>
        </div>
    }
    else
    {
        <p class="content">Using Project: <span class="tag">@EditorState.ProjectContext.ProjectPath</span></p>
    }
</div>

<ModalContent Id="genre-selection" @ref="GenreSelectionRef">
    <GenreSelectionModal Genres="GenreService.AvailablePlugins"
                         OnConfirmed="ConfirmCreateProject"
                         OnCancelled="() => ModalService.CloseModal()" />
</ModalContent>

@code 
{
    [CascadingParameter]
    public IModalInteractionService ModalService { get; set; }

    public ModalElementReference GenreSelectionRef { get; set; }

    public async Task CreateProject()
    {
        GenreService.RefreshPlugins();
        ModalService.ShowModal(GenreSelectionRef.Reference);
    }

    private async Task ConfirmCreateProject(GenreSelectionResult result)
    {
        var projectFolder = FileBrowser.BrowseToFolder();
        if (string.IsNullOrEmpty(projectFolder)) { return; }

        var newProject = await ProjectCreator.CreateProjectAt(projectFolder, result.EnabledGenreIds, result.GenerateTypeFiles);
        EditorState.ProjectContext = newProject;
        
        foreach (var genreId in result.EnabledGenreIds)
        {
            GenreService.EnablePlugin(genreId);
        }
        
        ModalService.CloseModal();
        EventBus.PublishAsync(new ProjectChangedEvent());
    }
    
    public async Task OpenProject()
    {
        var projectFile = FileBrowser.BrowseToOpenFile(filterList: "*.json");
        if(string.IsNullOrEmpty(projectFile)) { return; }

        var project = await EditorDataLoader.Load(projectFile);
        
        if (EditorState.ProjectContext?.Project?.Plugins != null)
        {
            foreach (var plugin in EditorState.ProjectContext.Project.Plugins)
            {
                GenreService.EnablePlugin(plugin.Id);
            }
        }
        
        EventBus.PublishAsync(new ProjectChangedEvent());
    }
}