@using OpenRpg.Editor.Infrastructure.Models
@using OpenRpg.Editor.Infrastructure.Services
@using OpenRpg.Localization.Data.Repositories

@inject ILocaleRepository Repository
@inject ILocaleComparisonService ComparisonService

<div class="box">
    <h3 class="title is-4 has-text-dark">Locale Editor For <code>@LocaleId</code></h3>

    @if (_localeEntries.Count == 0)
    {
        <div class="notification is-warning">No locale codes available.</div>
    }
    else
    {
        <div class="table-container">
            <table class="table is-fullwidth is-striped">
                <thead>
                    <tr>
                        <th>Locale Code</th>
                        <th>Locale Text</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _localeEntries)
                    {
                        <tr>
                            <td class="is-vcentered"><code>@entry.LocaleCode</code></td>
                            <td class="is-vcentered">
                                <input class="@ModalInputClass(entry.Exists)"
                                       type="text"
                                       value="@entry.LocaleText"
                                       @onchange='(ChangeEventArgs e) => OnEntryChanged(entry, e.Value?.ToString())' />
                            </td>
                            <td class="is-vcentered">
                                @if (entry.Exists)
                                {
                                    <span class="tag is-success">Exists</span>
                                }
                                else
                                {
                                    <span class="tag is-warning">New</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="field is-grouped">
        <div class="control">
            <button class="button is-link is-light" @onclick="Cancel">Close</button>
        </div>
    </div>
</div>

@functions {
    [Parameter]
    public string LocaleId { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancelled { get; set; }

    private List<LocaleEntry> _localeEntries = new();

    public void Cancel() => OnCancelled.InvokeAsync();

    protected override void OnParametersSet()
    {
        LoadEntries();
        base.OnParametersSet();
    }

    private void LoadEntries()
    {
        _localeEntries = new List<LocaleEntry>();
        foreach (var localeCode in Repository.DataSource.GetLocaleCodes().OrderBy(x => x))
        {
            var entry = ComparisonService.GetEntryFor(localeCode, LocaleId ?? string.Empty);
            _localeEntries.Add(entry);
        }
    }

    private string ModalInputClass(bool exists) => exists ? "input is-success" : "input is-warning";

    private void OnEntryChanged(LocaleEntry entry, string newValue)
    {
        if (newValue == null) return;
        entry.LocaleText = newValue;
        ComparisonService.SaveEntry(entry);
        StateHasChanged();
    }
}
