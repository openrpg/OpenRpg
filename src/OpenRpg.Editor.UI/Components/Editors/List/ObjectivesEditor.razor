@using OpenRpg.Editor.Infrastructure.Services
@using OpenRpg.Editor.UI.Services
@using OpenRpg.Quests

<ListEditor Data="Objectives" TItem="Objective">
    <HeaderTemplate>
        <th>Objective Type</th>
        <th>Associated Id</th>
        <th>Associated Value</th>
    </HeaderTemplate>
    <RowTemplate>
        <td>
            <div class="control">
                <div class="select is-fullwidth">
                    <select @bind="context.ObjectiveType">
                        @foreach (var objectiveType in GenreTypes.ObjectiveTypes)
                        {
                            <option value=@objectiveType.Id>@objectiveType.Name</option>
                        }
                    </select>
                </div>
            </div>
        </td>
        @{
            var idOptions = Resolver.GetOptionsFor(AssociationIdContexts.Objective, context.ObjectiveType);
        }
        <AssociationEditor Association="context.Association"
                          AssociationChanged="a => context.Association = a"
                          IdOptions="idOptions.Options"
                          IdDisabled="idOptions.Disabled"
                          ShowDropdown="idOptions.IsMapped" />
    </RowTemplate>
</ListEditor>

@code {
    [Inject]
    public GenreTypesService GenreTypes { get; set; }

    [Inject]
    public IAssociationIdResolver Resolver { get; set; }

    [Parameter]
    public List<Objective> Objectives { get; set; }
}
