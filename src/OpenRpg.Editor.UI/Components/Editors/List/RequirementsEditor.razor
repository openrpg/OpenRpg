@using OpenRpg.Core.Requirements
@using OpenRpg.Editor.Infrastructure.Services
@using OpenRpg.Editor.UI.Services

<ListEditor Data="Requirements" TItem="Requirement">
    <HeaderTemplate>
        <th>Requirement Type</th>
        <th>Associated Id</th>
        <th>Associated Value</th>
    </HeaderTemplate>
    <RowTemplate>
        <td>
            <div class="control">
                <div class="select is-fullwidth">
                    <select @bind="context.RequirementType">
                        @foreach (var requirementType in GenreTypes.RequirementTypes)
                        {
                            <option value=@requirementType.Id>@requirementType.Name</option>
                        }
                    </select>
                </div>
            </div>
        </td>
        @{
            var idOptions = Resolver.GetOptionsFor(AssociationIdContexts.Requirement, context.RequirementType);
        }
        <AssociationEditor Association="context.Association"
                          AssociationChanged="a => context.Association = a"
                          IdOptions="idOptions.Options"
                          IdDisabled="idOptions.Disabled"
                          ShowDropdown="idOptions.IsMapped" />
    </RowTemplate>
</ListEditor>

@code {
    [Inject]
    public GenreTypesService GenreTypes { get; set; }

    [Inject]
    public IAssociationIdResolver Resolver { get; set; }

    [Parameter]
    public List<Requirement> Requirements { get; set; }
}
