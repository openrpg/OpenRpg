@using System
@using System.Reflection
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using OpenRpg.Core.Effects
@using OpenRpg.Core.Requirements
@using OpenRpg.Core.Templates.Variables
@using OpenRpg.Editor.Core.Plugins
@using OpenRpg.Editor.Infrastructure.Editors
@using OpenRpg.Editor.Infrastructure.Extensions
@using OpenRpg.Editor.Infrastructure.Services
@using OpenRpg.Editor.UI.Components.Editors
@using OpenRpg.Editor.UI.Components.Editors.Common
@using OpenRpg.Editor.UI.Components.Editors.List
@using OpenRpg.Editor.UI.Services
@using OpenRpg.Entities.Extensions

@inject GenreTypesService GenreTypes
@inject IComponentTypeRegistry ComponentRegistry
@inject IEditorPropertyResolver PropertyResolver
@inject ITemplateOptionsResolver OptionsResolver

@typeparam TTemplate where TTemplate : class, OpenRpg.Core.Templates.ITemplate, OpenRpg.Core.Variables.General.IHasVariables<OpenRpg.Core.Templates.Variables.ITemplateVariables>, new()

<GenericTemplateEditor TTemplate="TTemplate" Template="Template" AssetCodePrefix="AssetCodePrefix">
    <AvatarContent>
        @if (AvatarContent != null)
        {
            @AvatarContent(Template)
        }
    </AvatarContent>
    <PrimaryDetailsContent>
        @foreach (var group in Groups)
        {
            <Accordion Title="@(group.Title)" IsExpanded="@ShouldGroupBeExpanded(group)">
                @RenderGroup(group)
            </Accordion>
        }
    </PrimaryDetailsContent>
</GenericTemplateEditor>

@code {
    [Parameter]
    public TTemplate Template { get; set; }

    [Parameter]
    public string AssetCodePrefix { get; set; }

    [Parameter]
    public IReadOnlyList<TemplateEditorGroup> ExternalGroups { get; set; } = new List<TemplateEditorGroup>();

    [Parameter]
    public RenderFragment<TTemplate> AvatarContent { get; set; }

    private List<TemplateEditorGroup> Groups = new();

    private Dictionary<string, PropertyInfo> _propertyMap = new();

    protected override void OnParametersSet()
    {
        if (Template != null)
        {
            _propertyMap = PropertyResolver.BuildPropertyMap(typeof(TTemplate));
            Groups = ExternalGroups.ToList();
        }
        base.OnParametersSet();
    }

    private RenderFragment RenderGroup(TemplateEditorGroup group)
    {
        if (!string.IsNullOrEmpty(group.EditorComponent))
        {
            return RenderTemplateLevelGroup(group);
        }

        if (group.Fields.Count == 0) return null;

        return builder =>
        {
            var seq = 0;
            foreach (var field in group.Fields)
            {
                var content = RenderField(field);
                builder.AddContent(seq++, content);
            }
        };
    }

    private RenderFragment RenderField(TemplateEditorField field)
    {
        if (!_propertyMap.TryGetValue(field.Property, out var property))
        {
            if (field.Property.StartsWith("Variables."))
            {
                return RenderVariableField(field);
            }

            return @<div class="notification is-warning mt-2">Property '@(field.Property)' not found</div>;
        }

        var editorType = !string.IsNullOrEmpty(field.EditorType) ? field.EditorType : PropertyResolver.GetEditorType(property);

        return editorType switch
        {
            "collection" => RenderCollection(property, field),
            "enumDropdown" => RenderEnumDropdown(property, field),
            "bool" => RenderBoolField(property, field),
            "unknown" => @<div class="notification is-warning mt-2">Unknown editor for '@(field.Property)'</div>,
            _ => RenderScalar(property, field)
        };
    }

    private RenderFragment RenderTemplateLevelGroup(TemplateEditorGroup group)
    {
        var componentName = group.EditorComponent;
        var componentType = ComponentRegistry.GetComponentType(componentName);

        if (componentType == null)
        {
            return @<div class="notification is-warning">Editor '@(componentName)' not found</div>;
        }

        if (componentName == nameof(TradeSkillDetailsEditor))
        {
            var isGathering = group.Options?.GetValueOrDefault("isGatheringSkill")?.ToLower() == "true";
            return builder =>
            {
                builder.OpenComponent(0, componentType);
                builder.AddAttribute(1, "TradeSkillTemplateVariables", Template.Variables);
                builder.AddAttribute(2, "IsGatheringSkill", isGathering);
                builder.CloseComponent();
            };
        }

        return builder =>
        {
            builder.OpenComponent(0, componentType);
            builder.AddAttribute(1, "Template", Template);
            builder.CloseComponent();
        };
    }

    private RenderFragment RenderVariableField(TemplateEditorField field)
    {
        var variables = Template.Variables;
        if (variables == null) return null;

        var fieldName = field.Property.Replace("Variables.", "");
        var typeSource = field.Options?.GetValueOrDefault("typeSource") ?? TemplateEditorConventions.GetTypeSource(field.Property);
        var label = !string.IsNullOrEmpty(field.Name) ? field.Name : TemplateEditorConventions.GetLabel(fieldName);

        if (fieldName.Contains("."))
        {
            return RenderNestedVariableField(fieldName, field, label);
        }

        var variablesType = variables.GetType();
        var prop = variablesType.GetProperty(fieldName);

        if (prop == null) return null;

        if (!string.IsNullOrEmpty(typeSource))
            return RenderVariableEnumDropdown(variables, prop, typeSource, label);

        if (prop.PropertyType == typeof(int))
            return RenderVariableIntField(variables, prop, label);

        if (prop.PropertyType == typeof(float) || prop.PropertyType == typeof(double))
            return RenderVariableFloatField(variables, prop, label);

        return RenderVariableTextField(variables, prop, label);
    }

    private RenderFragment RenderNestedVariableField(string fieldName, TemplateEditorField field, string label)
    {
        var parts = fieldName.Split('.');
        if (parts.Length != 2) return null;

        var containerName = parts[0];
        var propertyName = parts[1];

        var container = PropertyResolver.GetNestedVariableContainer(Template.Variables, containerName);
        if (container == null) return null;

        var containerType = container.GetType();
        var prop = containerType.GetProperty(propertyName);
        if (prop == null) return null;

        if (prop.PropertyType == typeof(int))
        {
            var currentValue = prop.GetValue(container) as int? ?? 0;
            return @<div class="field is-horizontal">
                <div class="field-label">
                    <label class="label">@label</label>
                </div>
                <div class="field-body">
                    <div class="field">
                        <div class="control">
                            <input class="input" type="number" value="@currentValue" @onchange="e => TemplatePropertyWriter.SetValue(prop, container, e.Value)" />
                        </div>
                    </div>
                </div>
            </div>;
        }

        if (prop.PropertyType == typeof(float) || prop.PropertyType == typeof(double))
        {
            var currentValue = prop.GetValue(container)?.ToString() ?? "0";
            return @<div class="field is-horizontal">
                <div class="field-label">
                    <label class="label">@label</label>
                </div>
                <div class="field-body">
                    <div class="field">
                        <div class="control">
                            <input class="input" type="number" step="0.1" value="@currentValue" @onchange="e => TemplatePropertyWriter.SetValue(prop, container, e.Value)" />
                        </div>
                    </div>
                </div>
            </div>;
        }

        return @<div class="notification is-info">[@containerName.@propertyName]</div>;
    }

    private RenderFragment RenderBoolField(PropertyInfo property, TemplateEditorField field)
    {
        var currentValue = property.GetValue(Template) as bool? ?? false;
        var label = !string.IsNullOrEmpty(field?.Name) ? field.Name : TemplateEditorConventions.GetLabel(property.Name);

        return @<div class="field is-horizontal">
            <div class="field-label">
                <label class="label">@label</label>
            </div>
            <div class="field-body">
                <div class="field">
                    <label class="checkbox">
                        <input type="checkbox" checked="@currentValue" @onchange="e => OnBoolChanged(property, e.Value)" />
                        @(currentValue ? "Yes" : "No")
                    </label>
                </div>
            </div>
        </div>;
    }

    private void OnBoolChanged(PropertyInfo property, object value)
    {
        TemplatePropertyWriter.SetValue(property, Template, value);
    }

    private RenderFragment RenderCollection(PropertyInfo property, TemplateEditorField field)
    {
        var elementType = PropertyResolver.GetCollectionElementType(property);
        var componentName = field.EditorComponent;
        var collectionValue = property.GetValue(Template) as System.Collections.IList;

        if (collectionValue == null)
        {
            var listType = typeof(List<>).MakeGenericType(elementType);
            collectionValue = Activator.CreateInstance(listType) as System.Collections.IList;
            property.SetValue(Template, collectionValue);
        }
        else if (collectionValue.GetType().IsArray)
        {
            var array = collectionValue as System.Array;
            var listType = typeof(List<>).MakeGenericType(elementType);
            var newList = Activator.CreateInstance(listType) as System.Collections.IList;
            if (array != null)
            {
                foreach (var item in array)
                {
                    newList?.Add(item);
                }
            }
            collectionValue = newList;
            property.SetValue(Template, collectionValue);
        }

        if (string.IsNullOrEmpty(componentName))
        {
            componentName = TemplateEditorConventions.GetCollectionComponent(elementType);
        }

        var componentType = ComponentRegistry.GetComponentType(componentName);
        if (componentType == null && !string.IsNullOrEmpty(componentName))
        {
            componentName = TemplateEditorConventions.GetCollectionComponent(elementType);
            componentType = ComponentRegistry.GetComponentType(componentName);
        }

        if (componentType == null)
        {
            return @<div class="notification is-warning">Editor '@(componentName)' not found for '@(property.Name)' (field.EditorComponent='@(field.EditorComponent ?? "null")', element=@(elementType?.Name ?? "null"))</div>;
        }

        var paramName = PropertyResolver.GetCollectionParamName(property.Name, componentType);
        return builder =>
        {
            builder.OpenComponent(0, componentType);
            builder.AddAttribute(1, paramName, collectionValue);
            builder.CloseComponent();
        };
    }

    private RenderFragment RenderEnumDropdown(PropertyInfo property, TemplateEditorField field)
    {
        var typeSource = field.Options?.GetValueOrDefault("typeSource") ?? TemplateEditorConventions.GetTypeSource(property.Name);
        var currentValue = property.GetValue(Template) as int? ?? 0;
        var options = OptionsResolver.GetOptionsForType(typeSource, typeof(TTemplate).Name);
        var label = !string.IsNullOrEmpty(field?.Name) ? field.Name : TemplateEditorConventions.GetLabel(property.Name);

        return @<div class="field is-horizontal">
            <div class="field-label">
                <label class="label">@label</label>
            </div>
            <div class="field-body">
                <div class="field">
                    <div class="control">
                        <div class="select is-fullwidth">
                            <select value="@currentValue" @onchange="e => OnEnumChanged(property, e.Value)">
                                <option value="0">Select...</option>
                                @foreach (var opt in options)
                                {
                                    <option value="@opt.Id">@opt.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>;
    }

    private void OnEnumChanged(PropertyInfo property, object value)
    {
        TemplatePropertyWriter.SetValue(property, Template, value);
    }

    private RenderFragment RenderVariableEnumDropdown(object variables, PropertyInfo field, string typeSource, string label)
    {
        var currentValue = field.GetValue(variables) as int? ?? 0;
        var options = OptionsResolver.GetOptionsForType(typeSource);

        return @<div class="field is-horizontal">
            <div class="field-label">
                <label class="label">@label</label>
            </div>
            <div class="field-body">
                <div class="field">
                    <div class="control">
                        <div class="select is-fullwidth">
                            <select value="@currentValue" @onchange="e => OnVariableFieldChanged(field.Name, e.Value)">
                                <option value="0">Select...</option>
                                @foreach (var opt in options)
                                {
                                    <option value="@opt.Id">@opt.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>;
    }

    private RenderFragment RenderVariableIntField(object variables, PropertyInfo field, string label)
    {
        var currentValue = field.GetValue(variables) as int? ?? 0;
        return @<div class="field is-horizontal">
            <div class="field-label">
                <label class="label">@label</label>
            </div>
            <div class="field-body">
                <div class="field">
                    <div class="control">
                        <input class="input" type="number" value="@currentValue" @onchange="e => OnVariableFieldChanged(field.Name, e.Value)" />
                    </div>
                </div>
            </div>
        </div>;
    }

    private RenderFragment RenderVariableFloatField(object variables, PropertyInfo field, string label)
    {
        var currentValue = field.GetValue(variables)?.ToString() ?? "0";
        return @<div class="field is-horizontal">
            <div class="field-label">
                <label class="label">@label</label>
            </div>
            <div class="field-body">
                <div class="field">
                    <div class="control">
                        <input class="input" type="number" step="0.1" value="@currentValue" @onchange="e => OnVariableFieldChanged(field.Name, e.Value)" />
                    </div>
                </div>
            </div>
        </div>;
    }

    private RenderFragment RenderVariableTextField(object variables, PropertyInfo field, string label)
    {
        var currentValue = field.GetValue(variables)?.ToString() ?? "";
        return @<div class="field is-horizontal">
            <div class="field-label">
                <label class="label">@label</label>
            </div>
            <div class="field-body">
                <div class="field">
                    <div class="control">
                        <input class="input" type="text" value="@currentValue" @onchange="e => OnVariableFieldChanged(field.Name, e.Value)" />
                    </div>
                </div>
            </div>
        </div>;
    }

    private RenderFragment RenderScalar(PropertyInfo property, TemplateEditorField field)
    {
        var label = !string.IsNullOrEmpty(field?.Name) ? field.Name : TemplateEditorConventions.GetLabel(property.Name);
        var propType = property.PropertyType;

        if (propType == typeof(int))
        {
            var currentValue = property.GetValue(Template) as int? ?? 0;
            return @<div class="field is-horizontal">
                <div class="field-label">
                    <label class="label">@label</label>
                </div>
                <div class="field-body">
                    <div class="field">
                        <div class="control">
                            <input class="input" type="number" value="@currentValue" @onchange="e => TemplatePropertyWriter.SetValue(property, Template, e.Value)" />
                        </div>
                    </div>
                </div>
            </div>;
        }

        if (propType == typeof(float) || propType == typeof(double))
        {
            var currentValue = property.GetValue(Template)?.ToString() ?? "0";
            return @<div class="field is-horizontal">
                <div class="field-label">
                    <label class="label">@label</label>
                </div>
                <div class="field-body">
                    <div class="field">
                        <div class="control">
                            <input class="input" type="number" step="0.1" value="@currentValue" @onchange="e => TemplatePropertyWriter.SetValue(property, Template, e.Value)" />
                        </div>
                    </div>
                </div>
            </div>;
        }

        if (propType == typeof(string))
        {
            var currentValue = property.GetValue(Template)?.ToString() ?? "";
            return @<div class="field is-horizontal">
                <div class="field-label">
                    <label class="label">@label</label>
                </div>
                <div class="field-body">
                    <div class="field">
                        <div class="control">
                            <input class="input" type="text" value="@currentValue" @onchange="e => TemplatePropertyWriter.SetValue(property, Template, e.Value)" />
                        </div>
                    </div>
                </div>
            </div>;
        }

        var currentRawValue = property.GetValue(Template);
        return @<div class="notification is-info">[@(property.Name): @(currentRawValue?.ToString() ?? "null")]</div>;
    }

    private bool ShouldGroupBeExpanded(TemplateEditorGroup group)
    {
        if (!string.IsNullOrEmpty(group.EditorComponent))
            return true;

        if (group.Fields.Count == 0)
            return true;

        var allCollections = true;
        foreach (var field in group.Fields)
        {
            if (_propertyMap.TryGetValue(field.Property, out var property))
            {
                var editorType = !string.IsNullOrEmpty(field.EditorType)
                    ? field.EditorType
                    : PropertyResolver.GetEditorType(property);

                if (editorType != "collection")
                {
                    allCollections = false;
                    break;
                }
            }
            else
            {
                if (!field.Property.StartsWith("Variables."))
                {
                    allCollections = false;
                    break;
                }
            }
        }

        if (!allCollections)
            return true;

        foreach (var field in group.Fields)
        {
            if (_propertyMap.TryGetValue(field.Property, out var property))
            {
                var collectionValue = property.GetValue(Template) as System.Collections.IList;
                if (collectionValue != null && collectionValue.Count > 0)
                    return true;
            }
        }

        return false;
    }

    private void OnVariableFieldChanged(string fieldName, object newValue)
    {
        var variables = Template.Variables;
        if (variables == null) return;

        var variablesType = variables.GetType();
        var field = variablesType.GetProperty(fieldName);
        if (field != null)
        {
            TemplatePropertyWriter.SetValue(field, variables, newValue);
        }
    }
}
