@using System
@using System.Reflection
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using OpenRpg.Core.Effects
@using OpenRpg.Core.Requirements
@using OpenRpg.Editor.Infrastructure.Editors
@using OpenRpg.Editor.Infrastructure.Extensions
@using OpenRpg.Editor.UI.Components.Editors.Common
@using OpenRpg.Entities.Extensions
@using OpenRpg.Localization.Data.Repositories
@using OpenRpg.Quests

@inject ILocaleRepository LocaleRepository

@if (Template != null)
{
<div class="container">
    <div class="box">
        <h3 class="title is-4">Template Asset Details</h3>
        <div class="field">
            <label class="label">Asset Code</label>
            <div class="control">
                <input class="input" type="text" value="@GetAssetCode()" @onchange="OnAssetCodeChanged" />
            </div>
        </div>
    </div>

    <div class="box">
        <h3 class="title is-4">Locale Details</h3>
        <div class="field">
            <label class="label">Name Locale Code</label>
            <div class="control">
                <input class="input" type="text" value="@GetNameLocaleId()" readonly />
            </div>
        </div>
        <div class="field">
            <label class="label">Description Locale Code</label>
            <div class="control">
                <input class="input" type="text" value="@GetDescriptionLocaleId()" readonly />
            </div>
        </div>
    </div>
    
    @foreach (var sec in GetSections())
    {
        <div class="box">
            <h3 class="title is-4">@sec.Title</h3>
            @RenderSection(sec)
        </div>
    }

    @if (HasEffects())
    {
        <div class="box">
            <h3 class="title is-4">Template Effects</h3>
            <div class="notification">@GetEffectsList().Count effects configured</div>
        </div>
    }

    @if (HasRequirements())
    {
        <div class="box">
            <h3 class="title is-4">Template Requirements</h3>
            <div class="notification">@GetRequirementsList().Count requirements configured</div>
        </div>
    }
</div>
}

@code {
    [Parameter]
    public object Template { get; set; }
    
    [Parameter]
    public RenderFragment PrimaryDetailsContent { get; set; }
    
    [Parameter]
    public RenderFragment SecondaryDetailsContent { get; set; }
    
    [Parameter]
    public string AssetCodePrefix { get; set; }
    
    [Parameter]
    public IReadOnlyList<TemplateEditorSection> Sections { get; set; } = new List<TemplateEditorSection>();
    
    public string FriendlyName { get; set; } = "";

    private Type _templateType;
    private Dictionary<string, PropertyInfo> _propertyMap = new();

    protected override void OnInitialized()
    {
        FriendlyName = AssetCodePrefix?.Capitalize() ?? "Template";
        
        if (Template == null) return;
        
        _templateType = Template.GetType();
        
        var listifyMethod = _templateType.GetMethod("ListifyProperties");
        listifyMethod?.Invoke(Template, null);
        
        BuildPropertyMap();
        base.OnInitialized();
    }

    private void BuildPropertyMap()
    {
        _propertyMap.Clear();
        var properties = _templateType.GetProperties(BindingFlags.Public | BindingFlags.Instance);
        foreach (var prop in properties)
        {
            _propertyMap[prop.Name] = prop;
        }
    }

    private object GetVariables()
    {
        return _propertyMap.GetValueOrDefault("Variables")?.GetValue(Template);
    }

    private int GetId()
    {
        return _propertyMap.GetValueOrDefault("Id")?.GetValue(Template) as int? ?? 0;
    }

    private string GetAssetCode()
    {
        var variables = GetVariables();
        if (variables == null) return $"{AssetCodePrefix}-{GetId()}";
        return variables.GetType().GetProperty("AssetCode")?.GetValue(variables)?.ToString() ?? "";
    }

    private string GetNameLocaleId()
    {
        var prop = _propertyMap.GetValueOrDefault("NameLocaleId");
        return prop?.GetValue(Template)?.ToString() ?? "";
    }

    private string GetDescriptionLocaleId()
    {
        var prop = _propertyMap.GetValueOrDefault("DescriptionLocaleId");
        return prop?.GetValue(Template)?.ToString() ?? "";
    }

    private void OnAssetCodeChanged(ChangeEventArgs e)
    {
        var newAssetCode = e.Value?.ToString() ?? "";
        var variables = GetVariables();
        if (variables != null)
        {
            var assetCodeProp = variables.GetType().GetProperty("AssetCode");
            assetCodeProp?.SetValue(variables, newAssetCode);
        }
        
        var updateLocaleMethod = _templateType.GetMethod("UpdateLocale");
        updateLocaleMethod?.Invoke(Template, new object[] { newAssetCode, LocaleRepository });
        
        StateHasChanged();
    }

    private IEnumerable<TemplateEditorSection> GetSections()
    {
        if (Sections != null && Sections.Count > 0)
        {
            return Sections;
        }

        var conventions = new List<TemplateEditorSection>();
        var properties = _templateType.GetProperties(BindingFlags.Public | BindingFlags.Instance);
        
        foreach (var prop in properties)
        {
            var editorType = TemplateEditorConventions.GetEditorType(prop.Name);
            if (editorType == "scalar") continue;
            
            var section = new TemplateEditorSection
            {
                Title = prop.Name,
                Property = prop.Name,
                EditorType = editorType
            };

            if (editorType == "collection")
            {
                var elementType = TemplateEditorConventions.GetCollectionElementType(prop);
                section.EditorComponent = TemplateEditorConventions.GetCollectionComponent(elementType);
            }

            conventions.Add(section);
        }

        return conventions;
    }

    private RenderFragment RenderSection(TemplateEditorSection sec)
    {
        if (string.IsNullOrEmpty(sec.Property)) return null;

        if (!_propertyMap.TryGetValue(sec.Property, out var property))
        {
            return @<div class="notification is-warning">Property '@sec.Property' not found on @FriendlyName</div>;
        }

        var editorType = sec.EditorType ?? TemplateEditorConventions.GetEditorType(sec.Property);

        return editorType switch
        {
            "collection" => RenderCollection(property, sec),
            "enumDropdown" => RenderEnumDropdown(property, sec),
            "variableField" => RenderVariableField(property, sec),
            _ => RenderScalar(property, sec)
        };
    }

    private RenderFragment RenderCollection(PropertyInfo property, TemplateEditorSection sec)
    {
        var elementType = TemplateEditorConventions.GetCollectionElementType(property);
        var componentName = sec.EditorComponent ?? TemplateEditorConventions.GetCollectionComponent(elementType);
        var count = GetCollectionCount(property);

        return @<div class="notification is-info">
            [@property.Name - @count items] (Editor: @componentName)
        </div>;
    }

    private int GetCollectionCount(PropertyInfo property)
    {
        var value = property.GetValue(Template);
        if (value is System.Collections.IEnumerable enumerable)
        {
            return enumerable.Cast<object>().Count();
        }
        return 0;
    }

    private RenderFragment RenderEnumDropdown(PropertyInfo property, TemplateEditorSection sec)
    {
        var typeSource = sec.Options.GetValueOrDefault("typeSource") ?? TemplateEditorConventions.GetTypeSource(property.Name);
        var currentValue = property.GetValue(Template) as int? ?? 0;

        return @<div class="field">
            <label class="label">@property.Name</label>
            <div class="control">
                <div class="select is-fullwidth">
                    <select value="@currentValue" @onchange="@(e => property.SetValue(Template, int.Parse(e.Value?.ToString() ?? "0")))">
                        <option value="0">@typeSource - Select option</option>
                    </select>
                </div>
            </div>
        </div>;
    }

    private RenderFragment RenderVariableField(PropertyInfo property, TemplateEditorSection sec)
    {
        var variables = GetVariables();
        if (variables == null) return null;
        
        var fieldName = property.Name.Replace("Variables.", "");
        var variablesType = variables.GetType();
        var field = variablesType.GetProperty(fieldName);
        var currentValue = field?.GetValue(variables)?.ToString() ?? "";

        return @<div class="field">
            <label class="label">@fieldName</label>
            <div class="control">
                <input class="input" type="text" value="@currentValue" @onchange="@(e => SetVariablesFieldValue(fieldName, e.Value))" />
            </div>
        </div>;
    }

    private RenderFragment RenderScalar(PropertyInfo property, TemplateEditorSection sec)
    {
        return @<div class="notification is-info">[@property.Name: @property.PropertyType.Name]</div>;
    }

    private void SetVariablesFieldValue(string fieldName, object newValue)
    {
        var variables = GetVariables();
        if (variables == null) return;
        
        var variablesType = variables.GetType();
        var field = variablesType.GetProperty(fieldName);
        if (field != null)
        {
            if (field.PropertyType == typeof(int))
            {
                field.SetValue(variables, int.TryParse(newValue?.ToString(), out var result) ? result : 0);
            }
            else
            {
                field.SetValue(variables, newValue);
            }
        }
    }

    private bool HasEffects()
    {
        var variables = GetVariables();
        if (variables == null) return false;
        
        var hasEffectsMethod = variables.GetType().GetMethod("HasEffects");
        return hasEffectsMethod?.Invoke(variables, null) as bool? ?? false;
    }

    private List<IEffect> GetEffectsList()
    {
        var variables = GetVariables();
        if (variables == null) return new List<IEffect>();
        
        var effectsProperty = variables.GetType().GetProperty("Effects");
        return effectsProperty?.GetValue(variables) as List<IEffect> ?? new List<IEffect>();
    }

    private bool HasRequirements()
    {
        var variables = GetVariables();
        if (variables == null) return false;
        
        var hasRequirementsMethod = variables.GetType().GetMethod("HasRequirements");
        return hasRequirementsMethod?.Invoke(variables, null) as bool? ?? false;
    }

    private List<Requirement> GetRequirementsList()
    {
        var variables = GetVariables();
        if (variables == null) return new List<Requirement>();
        
        var requirementsProperty = variables.GetType().GetProperty("Requirements");
        return requirementsProperty?.GetValue(variables) as List<Requirement> ?? new List<Requirement>();
    }
}