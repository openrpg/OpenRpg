@using OpenRpg.Data
@using OpenRpg.Data.Conventions.Extensions
@using OpenRpg.Editor.Core.Components
@using OpenRpg.Editor.UI.Services
@using OpenRpg.Entities.Entity.Templates
@using OpenRpg.Entities.Extensions
@using OpenRpg.Items.Extensions
@using OpenRpg.Items.Templates

@inject IRepository Repository
@inject GenreTypesService GenreTypes

@{
    var entityEquipment = Template.Variables.Equipment;
    var slotTypes = GenreTypes.ItemSlotTypes;
}

@if (entityEquipment != null)
{
    <Accordion Title="Starting Equipment" IsExpanded="@(entityEquipment.Slots.Count > 0)" BadgeCount="@entityEquipment.Slots.Count">
        <table class="table is-fullwidth is-rounded">
            <thead>
                <tr>
                    <th>Slot Type</th>
                    <th>Item</th>
                    <th style="max-width: 6em;">
                        <a class="tag is-primary" @onclick="AddEquipmentSlot">Add</a>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (entityEquipment.Slots.Count == 0)
                {
                    <tr>
                        <td colspan="10000" class="has-text-centered">
                            <p>No equipment defined</p>
                        </td>
                    </tr>
                }
                @foreach (var slotEntry in entityEquipment.Slots.ToList())
                {
                    var currentSlotKey = slotEntry.Key;
                    var itemData = slotEntry.Value;
                    <tr @key="currentSlotKey">
                        <td>
                            <div class="control">
                                <div class="select is-fullwidth">
                                    <select value="@currentSlotKey"
                                            @onchange='e => OnSlotTypeChanged(currentSlotKey, int.Parse(e.Value?.ToString() ?? "0"))'>
                                        <option value="0">Select...</option>
                                        @foreach (var slotType in slotTypes)
                                        {
                                            <option value="@slotType.Id">@slotType.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="control">
                                <div class="select is-fullwidth">
                                    <select @bind="itemData.TemplateId">
                                        <option value="0">None</option>
                                        @foreach (var itemTemplate in Repository.GetAll<ItemTemplate>())
                                        {
                                            <option value="@itemTemplate.Id">@itemTemplate.Variables.AssetCode</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </td>
                        <td>
                            <button class="button is-danger" @onclick="x => entityEquipment.Slots.Remove(currentSlotKey)">X</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Accordion>
}

@code {
    [Parameter]
    public EntityTemplate Template { get; set; }

    void AddEquipmentSlot()
    {
        var equipment = Template.Variables.Equipment;
        var slotTypes = GenreTypes.ItemSlotTypes;
        var slotType = slotTypes.Length > 0 ? slotTypes[0].Id : 1;
        equipment.Slots[slotType] = new ItemData();
    }

    void OnSlotTypeChanged(int oldKey, int newKey)
    {
        var equipment = Template.Variables.Equipment;
        if (oldKey == newKey || !equipment.Slots.ContainsKey(oldKey)) return;

        if (equipment.Slots.ContainsKey(newKey))
        {
            var existingItem = equipment.Slots[newKey];
            equipment.Slots[oldKey] = existingItem;
            equipment.Slots[newKey] = equipment.Slots[oldKey];
            equipment.Slots.Remove(oldKey);
            return;
        }

        var itemData = equipment.Slots[oldKey];
        equipment.Slots.Remove(oldKey);
        equipment.Slots[newKey] = itemData;
    }
}
