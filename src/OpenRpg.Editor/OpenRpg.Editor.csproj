<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ApplicationIcon>openrpg.ico</ApplicationIcon>
        <IsPackable>false</IsPackable>
        <WasmFingerprintAssets>false</WasmFingerprintAssets>
        <StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
        <StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
        <DisableBuildCompression>true</DisableBuildCompression>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <OutputType>WinExe</OutputType>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\OpenRpg.Data.InMemory\OpenRpg.Data.InMemory.csproj" />
      <ProjectReference Include="..\OpenRpg.Editor.UI\OpenRpg.Editor.UI.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Blazor-ApexCharts" Version="6.0.2" />
      <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    </ItemGroup>

    <ItemGroup>
        <None Update="openrpg.ico">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="_StaticWebAssetsComputeFilesToBuild" AfterTargets="GetCopyToOutputDirectoryItems" DependsOnTargets="ResolveStaticWebAssetsInputs">
        <ItemGroup>
            <!-- Filter the static web assets foreign to the project and then add them to the list of resolved
                 files to publish.
             -->
            <_ExternalBuildStaticWebAsset Include="%(StaticWebAsset.FullPath)" Condition="'%(SourceType)' != ''">
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <TargetPath>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)','$([MSBuild]::NormalizePath('wwwroot\%(BasePath)\%(RelativePath)'))'))</TargetPath>
            </_ExternalBuildStaticWebAsset>
            <!-- Remove any existing external static web asset that might have been added as part of the
                 regular publish pipeline. -->
            <_SourceItemsToCopyToOutputDirectory Remove="@(_ExternalBuildStaticWebAsset)" />
            <_SourceItemsToCopyToOutputDirectory Include="@(_ExternalBuildStaticWebAsset)" />
        </ItemGroup>
    </Target>

    <Target Name="CopyGenrePlugins" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
        <MakeDir Directories="$(OutputPath)Plugins" />
        <Copy SourceFiles="$(SolutionDir)OpenRpg.Genres.Fantasy\bin\$(Configuration)\$(TargetFramework)\OpenRpg.Genres.Fantasy.dll" DestinationFolder="$(OutputPath)Plugins" />
        <Copy SourceFiles="$(SolutionDir)OpenRpg.Genres.Fantasy\bin\$(Configuration)\$(TargetFramework)\OpenRpg.Genres.Fantasy.pdb" DestinationFolder="$(OutputPath)Plugins" Condition="Exists('$(SolutionDir)OpenRpg.Genres.Fantasy\bin\$(Configuration)\$(TargetFramework)\OpenRpg.Genres.Fantasy.pdb')" />
        <Copy SourceFiles="$(SolutionDir)OpenRpg.Genres.Scifi\bin\$(Configuration)\$(TargetFramework)\OpenRpg.Genres.Scifi.dll" DestinationFolder="$(OutputPath)Plugins" />
        <Copy SourceFiles="$(SolutionDir)OpenRpg.Genres.Scifi\bin\$(Configuration)\$(TargetFramework)\OpenRpg.Genres.Scifi.pdb" DestinationFolder="$(OutputPath)Plugins" Condition="Exists('$(SolutionDir)OpenRpg.Genres.Scifi\bin\$(Configuration)\$(TargetFramework)\OpenRpg.Genres.Scifi.pdb')" />
    </Target>
    
</Project>
