<div class="block accordion @(_isExpanded ? "is-expanded": "is-collapsed") @ContainerClasses">
    <a class="button is-flex @(HeaderClasses) has-text-left" @onclick="Toggle">
        <span class="has-text-weight-semibold is-leveled">
            @((MarkupString)Title)
            @if (BadgeCount.HasValue)
            {
                <span class="tag is-small is-info ml-2">@BadgeCount.Value</span>
            }
        </span>
        <span class="icon is-small is-pulled-right">
          <i class="fa @(_isExpanded ? "fa-circle-chevron-up" : "fa-circle-chevron-down")"></i>
        </span>
    </a>
    <div class="box @ContentClasses">
        @ChildContent 
    </div>
</div>

@code {

    [Parameter]
    public bool IsExpanded { get; set; } = false;
    
    [Parameter]
    public string HeaderClasses { get; set; } = "is-success";
    
    [Parameter]
    public string ContentClasses { get; set; } = "";
    
    [Parameter]
    public string ContainerClasses { get; set; } = string.Empty;
    
    [Parameter] 
    public RenderFragment ChildContent  { get; set; }
    
    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public int? BadgeCount { get; set; }

    private bool _isExpanded;
    private bool _initialized;

    protected override void OnInitialized()
    {
        _isExpanded = IsExpanded;
        _initialized = true;
    }

    protected override void OnParametersSet()
    {
        if (!_initialized)
            _isExpanded = IsExpanded;
    }

    private void Toggle()
    {
        _isExpanded = !_isExpanded;
    }
}