    <br />
    <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem;">
        @for (var i = 0; i < _validators.Count; i++)
        {
            var index = i;
            var isActive = _activeValidatorIndex == index;
            <button type="button"
                    @onclick="() => SetValidator(index)"
                    style="@(isActive
                        ? "padding: 0.5em 1em; border: 1px solid #363636; background: #363636; color: #fff; border-radius: 0.25em; cursor: pointer; font: inherit;"
                        : "padding: 0.5em 1em; border: 1px solid #dbdbdb; background: #fff; color: #363636; border-radius: 0.25em; cursor: pointer; font: inherit;")">
                @_validators[index].TabLabel
            </button>
        }
    </div>
    <p class="has-text-grey is-size-7">
        Active policy: <code>@_validators[_activeValidatorIndex].ClassName</code> &mdash;
        <em>@_validators[_activeValidatorIndex].DesignNote</em>
    </p>
    <br />
    <div class="columns">
        <div class="column is-one-third">
            <h6 class="title is-6 has-text-dark">Slots for active policy</h6>
            <div class="table-container">
                <table class="table is-fullwidth is-narrow is-hoverable">
                    <thead>
                        <tr>
                            <th>Slot</th>
                            <th>Accepts item type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slot in _validators[_activeValidatorIndex].Slots)
                        {
                            var captured = slot;
                            <tr class="@(_activeSlot == captured.SlotType ? "is-selected" : "")"
                                style="cursor: pointer;"
                                @onclick="() => SetSlot(captured.SlotType)">
                                <td>
                                    <strong>@captured.FriendlyName</strong>
                                    <br />
                                    <span class="has-text-grey is-size-7">id: @captured.SlotType</span>
                                </td>
                                <td>
                                    <span class="tag is-light">@captured.AcceptedItemTypeName</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="column">
            <h6 class="title is-6 has-text-dark">Sandbox inventory: Filtered by active slot</h6>
            <p class="has-text-grey is-size-7">
                @AcceptedSummaryText()
            </p>
            <div class="table-container">
                <table class="table is-fullwidth is-narrow is-striped">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Item type</th>
                            <th>Accepted?</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _sandboxItems)
                        {
                            var accepts = _validators[_activeValidatorIndex].Validator
                                .CanEquipItemType(_activeSlot, entry.ItemType);
                            <tr>
                                <td>
                                    <strong>@entry.Name</strong>
                                </td>
                                <td>
                                    <code>@entry.ItemType</code>
                                    <span class="has-text-grey is-size-7">
                                        &mdash; @ItemTypeName(entry.ItemType)
                                    </span>
                                </td>
                                <td>
                                    @if (accepts)
                                    {
                                        <span class="tag is-success is-light">&#x2713; accepts</span>
                                    }
                                    else
                                    {
                                        <span class="tag is-danger is-light">&#x2717; rejects</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</CardSection>
