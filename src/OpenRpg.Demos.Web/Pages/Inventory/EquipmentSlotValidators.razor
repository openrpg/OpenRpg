                    new SlotEntry(FantasyEquipmentSlotTypes.MainHandSlot,   "Main Hand",  OwnItemTypeName(FantasyItemTypes.GenericWeapon,    "Shared")),
                    new SlotEntry(FantasyEquipmentSlotTypes.OffHandSlot,    "Off Hand",   OwnItemTypeName(FantasyItemTypes.OffhandItem,      "Fantasy")),
